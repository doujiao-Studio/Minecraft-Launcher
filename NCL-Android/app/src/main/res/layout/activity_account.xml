<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            style="@style/NclCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正版登录（Microsoft 设备码）"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMsa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_primary_gradient"
                android:text="开始设备码登录"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/bg"
                android:padding="10dp"
                android:text="点击上方按钮后，这里会显示你要在浏览器里输入的验证码"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/btnOpenBrowser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="打开验证网页" />
        </LinearLayout>

        <LinearLayout
            style="@style/NclCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="外置登录（Yggdrasil）"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etYggServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="认证服务器地址"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etYggUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="邮箱 / 账号"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etYggPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="密码"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnYgg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="外置登录" />
        </LinearLayout>

        <LinearLayout
            style="@style/NclCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="离线登录"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="游戏名"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/offline_login" />
        </LinearLayout>

        <LinearLayout
            style="@style/NclCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已保存账户"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAccounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
